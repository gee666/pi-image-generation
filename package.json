{
  "name": "oira666_pi-image-generation",
  "version": "0.0.3",
  "description": "Image generation and reference-image editing for pi.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gee666/pi-image-generation.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "image-generation"
  ],
  "files": [
    "src",
    "resources",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": []
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.4.0",
    "typebox": "*"
  },
  "dependencies": {
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.20.0",
    "typebox": "^1.0.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "pretest": "npm install @earendil-works/pi-coding-agent@latest --save-dev --ignore-scripts && npm run check",
    "test": "tsx --test test/*.test.ts",
    "test:e2e": "tsx --test test/e2e/*.test.ts",
    "test:evergreen": "npm test && npm run test:e2e",
    "prepublishOnly": "npm run check && npm test"
  }
}
